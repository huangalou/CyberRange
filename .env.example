# CyberRange deployment env. Copy to `.env` on the deploy host and fill in.
# `.env` itself is gitignored; never commit real values.

# ─────────────── HTTP Basic Auth ───────────────
# Phase 1 single-user. Phase 2 will layer TOTP (env keeps the same shape).
# Generate the bcrypt hash with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
# Leave both blank to disable auth (DEV ONLY — never in prod).
CYBERRANGE_BASIC_USER=admin
CYBERRANGE_BASIC_PASS_BCRYPT=$2b$12$REPLACE_WITH_BCRYPT_HASH

# ─────────────── Sink policy ───────────────
# In prod, lock down to syslog-only and the SOC ingress IPs. Engine itself
# accepts any host:port; this allowlist is enforced at the API layer.
CYBERRANGE_ALLOWED_SINK_SCHEMES=udp,tcp
# ELK syslog sink — adjust to your own topology.
CYBERRANGE_ALLOWED_SINK_HOSTS=192.0.2.10

# ─────────────── CORS ───────────────
# Same-origin deploys (web + api behind one vhost) do not need cross-origin,
# but allowing the public hostname keeps Postman / external scripts working.
CYBERRANGE_ALLOWED_ORIGINS=https://bas.example.com

# ─────────────── Web build ───────────────
# Inlined into client JS at build time. `/api` works when the reverse proxy routes
# `/api/*` → api container under the same vhost.
NEXT_PUBLIC_API_BASE=/api

# API_HOST / API_PORT / API_LOG_LEVEL / CYBERRANGE_CATALOG_DIR are fixed in docker-compose.yml
